# Variables lues par le service « config-init » de docker-compose.prod.yml.
#   cp .env.plati.example .env.plati
#
# Elles ne servent QU'À la génération initiale de config/plati.yaml. Une fois ce
# fichier créé, c'est LUI qui fait autorité : modifier ce .env ensuite n'a plus
# aucun effet (le générateur ne réécrit jamais un fichier existant).
#
# Aucun secret ici : le mot de passe admin, jwt_secret et secret_encryption_key
# sont posés par l'assistant /setup au premier accès dans le navigateur.

# REQUIS — origine CORS et cible de la redirection après callback Entra.
# Doit aussi figurer dans server.allowedHosts de frontend/vite.config.ts.
# En dev : http://127.0.0.1:5300 — en prod : https://plati.burro-piranha.ts.net
PLATI_FRONTEND_URL=http://127.0.0.1:5300

# Backend. 0.0.0.0 est requis en dev : le backend est dans son propre conteneur,
# donc joignable par le frontend et par le port publié sur la boucle locale.
PLATI_SERVER_HOST=0.0.0.0
PLATI_SERVER_PORT=8080

# Incus tourne sur l'HÔTE. On vise la gateway du réseau Docker « plati » par son
# IP, PAS host.docker.internal : les deux piles mettent backend et frontend dans
# le netns du conteneur tailscale (network_mode: service:tailscale), et Docker
# REFUSE extra_hosts dans ce mode (« conflicting options: custom host-to-IP
# mapping and the network mode ») — host.docker.internal ne résoudrait donc pas.
# C'est précisément pour ça que le sous-réseau est figé dans les deux composes.
PLATI_INCUS_NAME=local
PLATI_INCUS_ENDPOINT=https://172.31.240.1:8443
# Chemins relatifs : résolus depuis le répertoire du fichier de config (./config).
PLATI_INCUS_CLIENT_CERT=plati-client.crt
PLATI_INCUS_CLIENT_KEY=plati-client.key
PLATI_INCUS_MAX_INSTANCES=50

# Persistance : /workspace/data est le volume plati-data.
PLATI_DB_PATH=/workspace/data/plati.db
PLATI_REPOS_DIR=/workspace/data/repos
# Relatif au répertoire de config → ./config/templates
PLATI_TEMPLATES_DIR=templates

PLATI_SLEEP_TIMEOUT=4h
PLATI_JWT_LIFETIME_HOURS=24

# Entra ID (optionnel) — peut aussi être renseigné dans l'assistant /setup.
#PLATI_ENTRA_CLIENT_ID=
#PLATI_ENTRA_CLIENT_SECRET=
#PLATI_ENTRA_TENANT_ID=
#PLATI_ENTRA_REDIRECT_URI=https://plati.burro-piranha.ts.net/auth/callback
